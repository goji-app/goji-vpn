<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             x:Class="GodjiVpn.Views.LoginView">
    <!-- Вход v5 «Стекло»: плашка Goji, глобус со спутниками, плотный стеклянный лист снизу.
         На macOS встроенного браузера для входа через сайт нет — вход по коду из письма. -->
    <Panel>
        <!-- ═══ Вход ═══ -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="18,16,18,20" IsVisible="{Binding !OtpSent}">
            <c:Globe Grid.Row="0" Grid.RowSpan="2" Satellites="True" RadiusFactor="0.34" Margin="-18,-16,-18,-8"/>

            <c:GlassPanel Classes="pill" HorizontalAlignment="Left" Padding="5,5,13,5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource InkBrush}">
                        <Image Source="avares://GojiVpn/Assets/Images/logo.png" Width="20" Height="20"/>
                    </Border>
                    <TextBlock Text="Goji" FontWeight="Bold" FontSize="{s:Fs 15}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
            </c:GlassPanel>

            <c:GlassPanel Grid.Row="2" Classes="strong" CornerRadius="32" Margin="0,12,0,0">
                    <StackPanel Margin="16,20,16,16">
                        <TextBlock Text="Привет. Куда&#10;подключаемся сегодня?" FontWeight="SemiBold" FontSize="{s:Fs 30}" LineHeight="{s:Fs 33}" TextWrapping="Wrap"/>

                        <!-- Вход — только email и код из письма, как во всех приложениях Goji. Аккаунт и
                             пробный период создаются сами; пробный период включается на главной. -->
                        <TextBlock Text="Email" FontWeight="SemiBold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,16,0,6"/>
                        <TextBox Name="EmailBox" Classes="glass" Text="{Binding Email}" Watermark="you@mail.ru" AutomationProperties.Name="Email"/>
                        <Button Classes="accent" Height="54" FontSize="{s:Fs 15}" Margin="0,12,0,0"
                                Content="{Binding SendOtpButtonText}" Command="{Binding SendOtpCommand}"/>

                        <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextAlignment="Center" Margin="0,10,0,0"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <TextBlock Classes="muted" Text="Аккаунта нет? Создадим сами, ничего заполнять не нужно." FontSize="{s:Fs 11}"
                                   TextAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Classes="muted" FontSize="{s:Fs 11}" TextAlignment="Center" Text="Создавая аккаунт, вы соглашаетесь с"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Classes="bare" Command="{Binding OpenTermsCommand}">
                                <TextBlock Text="пользовательским соглашением" FontSize="{s:Fs 11}" FontWeight="SemiBold" Foreground="{DynamicResource TealDeepBrush}"/>
                            </Button>
                            <TextBlock Classes="muted" FontSize="{s:Fs 11}" Text=" и "/>
                            <Button Classes="bare" Command="{Binding OpenPrivacyCommand}">
                                <TextBlock Text="политикой конфиденциальности" FontSize="{s:Fs 11}" FontWeight="SemiBold" Foreground="{DynamicResource TealDeepBrush}"/>
                            </Button>
                            <TextBlock Classes="muted" FontSize="{s:Fs 11}" Text="."/>
                        </WrapPanel>
                    </StackPanel>
            </c:GlassPanel>
        </Grid>

        <!-- ═══ Подтверждение почты ═══ -->
        <Grid Margin="18,16,18,20" IsVisible="{Binding OtpSent}">
            <Button Classes="circle" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding ChangeEmailCommand}"
                    IsVisible="{Binding !IsVerifySuccess}" ToolTip.Tip="Назад">
                <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="20" Height="20"/>
            </Button>

            <c:GlassPanel Classes="strong" CornerRadius="32" VerticalAlignment="Bottom">
                <Panel Margin="20,22,20,20">
                    <StackPanel IsVisible="{Binding !IsVerifySuccess}">
                        <TextBlock Text="Подтверди почту" FontWeight="SemiBold" FontSize="{s:Fs 30}"/>
                        <TextBlock Classes="muted" FontSize="{s:Fs 13}" Margin="0,6,0,0">
                            <Run Text="Код отправлен на "/><Run Text="{Binding Email}"/>
                        </TextBlock>
                        <c:OtpInput Name="Otp" Code="{Binding Code}" Margin="-4,18,-4,0"
                                    HasError="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Classes="muted" FontSize="{s:Fs 11.5}" Margin="0,12,0,0" Text="{Binding VerifyHint}"/>
                        <TextBlock Classes="error" Text="{Binding ErrorMessage}" Margin="0,8,0,0"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Button Classes="accent" Height="52" FontSize="{s:Fs 15}" Margin="0,16,0,0" Content="Подтвердить" Command="{Binding VerifyCommand}"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsVerifySuccess}" HorizontalAlignment="Center" Margin="0,8">
                        <TextBlock Text="Готово!" FontWeight="SemiBold" FontSize="{s:Fs 22}" Foreground="{DynamicResource TealDeepBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Classes="muted" Text="Почта подтверждена" FontSize="{s:Fs 12.5}" HorizontalAlignment="Center" Margin="0,4,0,22"/>
                        <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource TealBrush}" HorizontalAlignment="Center">
                            <Path Classes="icon white" Data="{StaticResource IconCheck}" Width="44" Height="44"/>
                        </Border>
                    </StackPanel>
                </Panel>
            </c:GlassPanel>
        </Grid>
    </Panel>
</UserControl>
