<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- «Goji Expressive» (Material 3 Expressive), тёмная тема — 1:1 с Android GodjiColors.applyDark() (Color.kt).
         Тональные поверхности вместо стекла: без размытия, бликов, кромок и теней. Имена
         ключей v5 сохранены, как и в Android, — экраны продолжают их читать, а значения
         теперь роли M3: TextPrimary = onSurface, Teal = primary, TealTint = primaryContainer,
         Chip = surfaceContainerHigh, Thumb/Lens = secondaryContainer, Surface = onPrimary
         (текст на акценте). Поля, которые больше ничего не рисуют (блики, кромки, пятна
         фона), прозрачные. BgBrush = Transparent — под экранами сплошной фон GlassBackdrop. -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#0E1513"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#161D1C"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#1A2120"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#252B2A"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#2F3635"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#80D5CA"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#003732"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#005049"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#9DF2E6"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#334B48"/>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#CCE8E3"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#7B2F12"/>
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="#FFDBCF"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="#93000A"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#889391"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#3F4947"/>
    <SolidColorBrush x:Key="BgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="BgSolidBrush" Color="#0E1513"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#003732"/>
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#252B2A"/>
    <SolidColorBrush x:Key="InkBrush" Color="#DDE4E1"/>
    <SolidColorBrush x:Key="InkShadowBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DDE4E1"/>
