<Window x:Class="GodjiVpn.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
        xmlns:controls="clr-namespace:GodjiVpn.Controls"
        Title="Godji VPN" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource BgSolidBrush}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- QR-код текста — порт QrDialog (Android, 79b3e4b): заголовок, пояснение, код на белой
         подложке (сканеры плохо читают код на цветном/прозрачном фоне), подпись, "Закрыть". -->
    <Grid>
        <controls:GlassBackdrop/>
        <controls:GlassPanel Style="{StaticResource GlassStrong}" CornerRadius="28" Margin="16">
            <StackPanel Margin="20">
                <TextBlock x:Name="TitleBlock" FontWeight="Bold" FontSize="{s:Fs 20}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="SubtitleBlock" FontWeight="Medium" FontSize="{s:Fs 12}" LineHeight="{s:Fs 17}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                <Border x:Name="QrBox" Width="236" Height="236" CornerRadius="20" Background="White" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" Padding="14" Margin="0,14,0,0">
                    <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                </Border>
                <Border x:Name="WarningBox" CornerRadius="14" Background="{DynamicResource TerracottaTintBrush}" Padding="12,9"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WarningBlock" FontWeight="SemiBold" FontSize="{s:Fs 11.5}" LineHeight="{s:Fs 16}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"/>
                </Border>
                <TextBlock x:Name="CaptionBlock" FontWeight="SemiBold" FontSize="{s:Fs 12}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                <Button Content="Закрыть" Height="44" Margin="0,14,0,0" Click="OnCloseClick" IsCancel="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontSize" Value="{s:Fs 13.5}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </controls:GlassPanel>
    </Grid>
</Window>
