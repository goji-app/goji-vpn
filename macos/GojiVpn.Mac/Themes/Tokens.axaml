            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#252B2A"/>
            <SolidColorBrush x:Key="InkBrush" Color="#DDE4E1"/>
            <SolidColorBrush x:Key="InkShadowBrush" Color="#00000000"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DDE4E1"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BEC9C6"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#889391"/>
            <SolidColorBrush x:Key="TealBrush" Color="#80D5CA"/>
            <SolidColorBrush x:Key="TealBrightBrush" Color="#80D5CA"/>
            <SolidColorBrush x:Key="TealDeepBrush" Color="#80D5CA"/>
            <SolidColorBrush x:Key="TealTintBrush" Color="#005049"/>
