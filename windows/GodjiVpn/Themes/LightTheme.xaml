    <SolidColorBrush x:Key="TealBrush" Color="#006A62"/>
    <SolidColorBrush x:Key="TealBrightBrush" Color="#006A62"/>
    <SolidColorBrush x:Key="TealDeepBrush" Color="#006A62"/>
    <SolidColorBrush x:Key="TealTintBrush" Color="#9DF2E6"/>
    <SolidColorBrush x:Key="TealTintBorderBrush" Color="#006A62"/>
    <SolidColorBrush x:Key="TerracottaBrush" Color="#9A4524"/>
    <SolidColorBrush x:Key="TerracottaDeepBrush" Color="#7B2F12"/>
    <SolidColorBrush x:Key="TerracottaTintBrush" Color="#FFDBCF"/>
    <SolidColorBrush x:Key="TerracottaTintBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8A6100"/>
