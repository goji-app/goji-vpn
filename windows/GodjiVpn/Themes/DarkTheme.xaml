    <SolidColorBrush x:Key="TealDeepBrush" Color="#80D5CA"/>
    <SolidColorBrush x:Key="TealTintBrush" Color="#005049"/>
    <SolidColorBrush x:Key="TealTintBorderBrush" Color="#80D5CA"/>
    <SolidColorBrush x:Key="TerracottaBrush" Color="#FFB59A"/>
    <SolidColorBrush x:Key="TerracottaDeepBrush" Color="#FFDBCF"/>
    <SolidColorBrush x:Key="TerracottaTintBrush" Color="#7B2F12"/>
