<UserControl x:Class="GodjiVpn.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls"
             xmlns:vm="clr-namespace:GodjiVpn.ViewModels">
    <!-- Серверы v5 «Стекло» — по эталону screens/*-servers.png и ServersScreen.kt: колонка
         padding 16, gap 12; все узлы — ОДНА карточка со строками через Hair. -->
    <!-- Без прокрутки: список узлов занимает оставшееся место и листается страницами. -->
    <Grid Margin="16" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Где выйти в сеть" Style="{StaticResource ScreenTitle}" TextWrapping="Wrap"/>
                    <TextBlock FontWeight="Medium" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0">
                        <Run Text="{Binding Nodes.Count, Mode=OneWay}"/><Run Text=" узлов в подписке"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <Button Style="{StaticResource GlassCircleButton}" Command="{Binding RefreshCommand}">
                            <Grid>
                                <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource TerracottaBrush}"
                                      Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <controls:Spinner Foreground="{DynamicResource TerracottaBrush}"
                                                  Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="Обновить" FontWeight="Bold" FontSize="{s:Fs 9.5}" Foreground="{DynamicResource TerracottaBrush}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource GlassCircleButton}" Command="{Binding PingAllCommand}">
                            <Grid>
                                <Path Data="{StaticResource IconBolt}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource TealDeepBrush}"
                                      Visibility="{Binding IsCheckingAll, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <controls:Spinner Foreground="{DynamicResource TealDeepBrush}"
                                                  Visibility="{Binding IsCheckingAll, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="Пинг" FontWeight="Bold" FontSize="{s:Fs 9.5}" Foreground="{DynamicResource TealDeepBrush}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Сортировка (Android 64aa106): тот же сегмент-контрол, что "Язык" в Настройках, ниже — 32. -->
            <controls:SegmentedControl Grid.Row="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}"
                                       ItemHeight="32" LabelFontSize="12" Margin="0,12,0,0"/>

            <!-- Баннер-результат ручного "Обновить": круг 24 с галочкой/!, текст 12, крестик 22. -->
            <controls:GlassPanel Grid.Row="2" CornerRadius="20" Padding="13,11" Margin="0,12,0,0"
                                 Visibility="{Binding RefreshResultMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <controls:GlassPanel.Style>
                    <Style TargetType="controls:GlassPanel" BasedOn="{StaticResource GlassPill}">
                        <Setter Property="Tint" Value="{DynamicResource BannerOkBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RefreshResultIsError}" Value="True">
                                <Setter Property="Tint" Value="{DynamicResource BannerWarnBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:GlassPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24">
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TealBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RefreshResultIsError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource TerracottaBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Path Width="13" Height="13" Fill="{DynamicResource SurfaceBrush}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                    <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RefreshResultIsError}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconPriorityHigh}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding RefreshResultMessage}" FontWeight="SemiBold" FontSize="{s:Fs 12}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Grid.Column="2" Style="{StaticResource BareButton}" Command="{Binding DismissRefreshResultCommand}" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource HairBrush}">
                            <TextBlock Text="×" FontWeight="Bold" FontSize="{s:Fs 13}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </Button>
                </Grid>
            </controls:GlassPanel>

            <!-- Все узлы — одна карточка. -->
            <controls:GlassPanel Grid.Row="3" Style="{StaticResource GlassCard}" Margin="0,12,0,0" VerticalAlignment="Top">
                <controls:PagedItems ItemsSource="{Binding Nodes}">
                    <controls:PagedItems.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NodeItem}">
                            <StackPanel>
                                <Rectangle Style="{StaticResource PagedSep}"/>
                                <Grid x:Name="Row" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Выбор узла: флаг 36 r12, имя 13.5 Bold, галочка у выбранного. -->
                                    <Button Style="{StaticResource BareButton}" controls:Press.Scale="1"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                            CommandParameter="{Binding}" Padding="14,12,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="FlagBox" Width="36" Height="36" CornerRadius="12" Background="{DynamicResource ChipBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Border Width="22" Height="16" CornerRadius="3" ClipToBounds="True"
                                                            Visibility="{Binding FlagImagePath, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <Image Source="{Binding FlagImagePath}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Path Data="{StaticResource IconGlobe}" Style="{StaticResource Icon}" Width="17" Height="17"
                                                          Fill="{DynamicResource TextSecondaryBrush}"
                                                          Visibility="{Binding FlagImagePath, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="{s:Fs 13.5}"
                                                       VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                                            <Path x:Name="Check" Grid.Column="2" Data="{StaticResource IconCheck}" Style="{StaticResource Icon}"
                                                  Width="18" Height="18" Fill="{DynamicResource TealDeepBrush}" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>

                                    <!-- Избранное — в эталоне его нет, но это рабочая функция приложения. -->
                                    <Button Grid.Column="1" Style="{StaticResource BareButton}" Padding="6" Margin="4,0,0,0"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                            CommandParameter="{Binding}" VerticalAlignment="Center">
                                        <Path x:Name="Star" Data="{StaticResource IconStarOutline}" Style="{StaticResource Icon}" Width="15" Height="15"
                                              Fill="{DynamicResource TextMutedBrush}"/>
                                    </Button>

                                    <!-- Плашка пинга — отдельная кнопка: проверить только этот узел. -->
                                    <Button Grid.Column="2" Style="{StaticResource BareButton}" controls:Press.Scale="0.94" Margin="4,0,10,0"
                                            Command="{Binding DataContext.PingOneCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                            CommandParameter="{Binding}" VerticalAlignment="Center">
                                        <controls:GlassPanel Style="{StaticResource GlassFlat}" CornerRadius="999" MinWidth="70" Height="30" Padding="11,0">
                                            <TextBlock x:Name="Ping" Text="{Binding PingLabel}" FontWeight="Bold" FontSize="{s:Fs 11.5}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </controls:GlassPanel>
                                    </Button>

                                    <!-- Узел, добавленный вручную по JSON — только у таких есть удаление. -->
                                    <Button Grid.Column="3" Style="{StaticResource BareButton}" Padding="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.RemoveCustomNodeCommand, RelativeSource={RelativeSource AncestorType=controls:PagedItems}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconDelete}" Style="{StaticResource Icon}" Width="15" Height="15" Fill="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                                    <Setter TargetName="FlagBox" Property="BorderBrush" Value="{DynamicResource TealBrush}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="Star" Property="Data" Value="{StaticResource IconStar}"/>
                                    <Setter TargetName="Star" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingLevel}" Value="Good">
                                    <Setter TargetName="Ping" Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingLevel}" Value="Mid">
                                    <Setter TargetName="Ping" Property="Foreground" Value="#C98B12"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingLevel}" Value="Bad">
                                    <Setter TargetName="Ping" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </controls:PagedItems.ItemTemplate>
                </controls:PagedItems>
            </controls:GlassPanel>

    </Grid>
</UserControl>
