<UserControl x:Class="GodjiVpn.Controls.DaysRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             Width="68" Height="68">
    <!-- Кольцо дней v5 (PlansScreen.kt DaysRing): дорожка TrackBg 7, дуга Teal без скруглённых
         концов (как conic-заливка эталона), ядро RingCore 54 с числом 19 ExtraBold и "ДНЕЙ". -->
    <Grid>
        <Ellipse Stroke="{DynamicResource TrackBgBrush}" StrokeThickness="7"/>
        <Path x:Name="ArcPath" StrokeThickness="7" Stroke="{DynamicResource TealBrush}"/>
        <Ellipse Width="54" Height="54" Fill="{DynamicResource RingCoreBrush}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="DaysText" FontFamily="{StaticResource ManropeFamily}" FontWeight="ExtraBold" FontSize="{s:Fs 19}"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" LineHeight="{s:Fs 19}"
                       LineStackingStrategy="BlockLineHeight"/>
            <TextBlock Text="ДНЕЙ" FontFamily="{StaticResource ManropeFamily}" FontWeight="Bold" FontSize="{s:Fs 7.5}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
