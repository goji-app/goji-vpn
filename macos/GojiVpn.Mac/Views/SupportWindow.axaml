<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GodjiVpn.Controls"
        x:Class="GodjiVpn.Views.SupportWindow"
        Title="Поддержка" Width="460" Height="720" MinWidth="260" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgSolidBrush}">
    <!-- Окно поддержки: список обращений / переписка / новое обращение / FAQ — какая View
         показывается, решают DataTemplates в App.axaml по типу CurrentViewModel. -->
    <!-- Как главное окно: экраны на холсте 440×680 масштабируются под размер окна. -->
    <Panel>
        <c:GlassBackdrop/>
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <ContentControl Content="{Binding CurrentViewModel}" Width="440" Height="680"/>
        </Viewbox>
    </Panel>
</Window>
