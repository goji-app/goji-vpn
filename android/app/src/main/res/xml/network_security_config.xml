<?xml version="1.0" encoding="utf-8"?>
<!-- Стандартное системное доверие для HTTPS-запросов к вашему API (не влияет на VLESS/Reality-туннель — тот работает внутри Xray-core со своей TLS-логией) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Проверка утечек (NetworkDiagnostics): бесплатные эндпоинты ip-api.com, включая
         определение DNS-резолвера edns.ip-api.com (случайные поддомены), работают только по
         HTTP. Никаких данных пользователя туда не уходит — только сам факт запроса. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ip-api.com</domain>
    </domain-config>
</network-security-config>
