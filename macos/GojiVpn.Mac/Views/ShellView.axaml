<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:GodjiVpn.Utils"
             xmlns:c="using:GodjiVpn.Controls"
             xmlns:conv="using:GodjiVpn.Converters"
             x:Class="GodjiVpn.Views.ShellView">
    <!-- Оболочка: четыре вкладки и короткая нижняя панель навигации M3 Expressive (порт Android
         GlassTabBar.kt, 163f5ab, как ShellView Windows-клиента): во всю ширину, surfaceContainer,
         высота 64; у выбранной вкладки под иконкой таблетка secondaryContainer 56×32 раскрывается
         пружиной от 24 до 56. -->
    <UserControl.Styles>
        <Style Selector="Button.tab">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.tab Border.indicator">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource LensBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.4" Easing="BackEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab.selected Border.indicator">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.tab Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Button.tab.selected Path">
            <Setter Property="Stroke" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        </Style>
        <Style Selector="Button.tab TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{s:Fs 12}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Button.tab.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>
    <Panel>
        <Panel Margin="0,0,0,64">
            <ContentControl Content="{Binding Connect}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=0}"/>
            <ContentControl Content="{Binding Servers}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=1}"/>
            <ContentControl Content="{Binding Plans}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=2}"/>
            <ContentControl Content="{Binding Settings}" IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=3}"/>
        </Panel>

        <Border Height="64" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceContainerBrush}">
            <UniformGrid Rows="1" Columns="4">
                <Button Classes="bare tab" Tag="0" Click="OnTabClick"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=0}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <Panel Width="56" Height="32" HorizontalAlignment="Center">
                            <Border Classes="indicator"/>
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="{StaticResource TabIconHome}"/></Canvas></Viewbox>
                        </Panel>
                        <TextBlock Text="Главная"/>
                    </StackPanel>
                </Button>
                <Button Classes="bare tab" Tag="1" Click="OnTabClick"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=1}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <Panel Width="56" Height="32" HorizontalAlignment="Center">
                            <Border Classes="indicator"/>
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="{StaticResource TabIconServers}"/></Canvas></Viewbox>
                        </Panel>
                        <TextBlock Text="Серверы"/>
                    </StackPanel>
                </Button>
                <Button Classes="bare tab" Tag="2" Click="OnTabClick"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=2}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <Panel Width="56" Height="32" HorizontalAlignment="Center">
                            <Border Classes="indicator"/>
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="{StaticResource TabIconPlans}"/></Canvas></Viewbox>
                        </Panel>
                        <TextBlock Text="Подписка"/>
                    </StackPanel>
                </Button>
                <Button Classes="bare tab" Tag="3" Click="OnTabClick"
                        Classes.selected="{Binding SelectedTabIndex, Converter={x:Static conv:Conv.IntEquals}, ConverterParameter=3}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <Panel Width="56" Height="32" HorizontalAlignment="Center">
                            <Border Classes="indicator"/>
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="{StaticResource TabIconSettings}"/></Canvas></Viewbox>
                        </Panel>
                        <TextBlock Text="Настройки"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Panel>
</UserControl>
