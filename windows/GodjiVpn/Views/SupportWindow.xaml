<Window x:Class="GodjiVpn.Views.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GodjiVpn.Controls"
        Title="Поддержка" Height="720" Width="460"
        MinHeight="400" MinWidth="260"
        Background="{DynamicResource BgSolidBrush}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <!-- Аналог MainWindow — какая View показывается, решают DataTemplate'ы в App.xaml по типу
         CurrentViewModel (SupportShellViewModel переключает список/создание/чат/FAQ). Каждый
         экран сам рисует свою шапку с "← Назад" — здесь общего заголовка нет, как и в Android,
         где у каждого экрана своя TopAppBar. -->
    <!-- Как главное окно: экраны на холсте 440×680 масштабируются под размер окна (FitScaler). -->
    <Grid>
        <controls:GlassBackdrop/>
        <controls:FitScaler>
            <ContentControl Content="{Binding CurrentViewModel}" Width="440" Height="680"/>
        </controls:FitScaler>
    </Grid>
</Window>
