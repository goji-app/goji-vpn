    <!-- Градиенты v5 сведены к плоскому primary — в M3E заливки однотонные. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80D5CA" Offset="0"/>
        <GradientStop Color="#80D5CA" Offset="1"/>
    </LinearGradientBrush>
    <sys:Double x:Key="BlobAlpha">0</sys:Double>

