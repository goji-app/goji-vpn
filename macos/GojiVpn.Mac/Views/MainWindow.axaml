<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GodjiVpn.Controls"
        x:Class="GodjiVpn.Views.MainWindow"
        Title="Goji VPN" Width="440" Height="820" MinWidth="280" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgSolidBrush}">
    <!-- Общий живой фон под всеми экранами; какой экран показан (вход или оболочка с
         вкладками), решают DataTemplates в App.axaml по типу CurrentViewModel.
         Экраны свёрстаны на холсте 440×820 и целиком масштабируются под окно (Viewbox):
         растягиваешь окно — интерфейс пропорционально крупнее, прокрутки нет. При другом
         соотношении сторон по краям виден тот же фон. -->
    <Panel>
        <c:GlassBackdrop/>
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <ContentControl Content="{Binding CurrentViewModel}" Width="440" Height="820"/>
        </Viewbox>
    </Panel>
</Window>
