<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- «Goji Expressive» (Material 3 Expressive), светлая тема — 1:1 с Android GodjiColors.applyLight() (Color.kt).
         Тональные поверхности вместо стекла: без размытия, бликов, кромок и теней. Имена
         ключей v5 сохранены, как и в Android, — экраны продолжают их читать, а значения
         теперь роли M3: TextPrimary = onSurface, Teal = primary, TealTint = primaryContainer,
         Chip = surfaceContainerHigh, Thumb/Lens = secondaryContainer, Surface = onPrimary
         (текст на акценте). Поля, которые больше ничего не рисуют (блики, кромки, пятна
         фона), прозрачные. BgBrush = Transparent — под экранами сплошной фон GlassBackdrop. -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#F4FBF8"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#EEF5F2"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#E8EFEC"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#E3EAE7"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#DDE4E1"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#006A62"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#9DF2E6"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#00201D"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#CCE8E3"/>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#051F1C"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#FFDBCF"/>
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="#380D00"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="#FFDAD6"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#6F7977"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#BEC9C6"/>
    <SolidColorBrush x:Key="BgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="BgSolidBrush" Color="#F4FBF8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#E3EAE7"/>
    <SolidColorBrush x:Key="InkBrush" Color="#161D1C"/>
    <SolidColorBrush x:Key="InkShadowBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#161D1C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3F4947"/>
