<?xml version="1.0" encoding="utf-8"?>
<!-- Сборка site (сайт загрузки / GitHub, см. app/build.gradle.kts) — только она умеет обновлять
     себя сама. В сборку для Google Play ничего из этого файла не попадает. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Установка скачанного самим приложением APK-обновления (см. AppUpdateDownloader). Android
         при первой попытке сам покажет экран «Разрешить установку из этого источника». -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Завершение загрузки APK-обновления (см. AppUpdateDownloader): DownloadManager
             переживает смерть процесса, поэтому приёмник в манифесте. DOWNLOAD_COMPLETE —
             защищённый системный broadcast. -->
        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Отдаёт скачанный APK системному установщику через content:// (см. installApk). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
