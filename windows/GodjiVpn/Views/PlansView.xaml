<UserControl x:Class="GodjiVpn.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls"
             xmlns:utils="clr-namespace:GodjiVpn.Utils">
    <!-- Подписка v5 «Стекло» — по эталону screens/*-plans.png и PlansScreen.kt (разметка
         handoff-1.0.77/reference/GojiGlassFull.dc.html, isPlans): колонка padding 16, gap 12. -->
    <!-- Без прокрутки: сверху шапка и карточка подписки, под ними переключатель разделов
         (устройства · друзья · новости); раздел занимает оставшееся место, длинные
         списки листаются страницами (PagedItems). -->
    <Grid Margin="16" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- Шапка: заголовок, подзаголовок, ID-чип (копирует) + круглая кнопка обновления. -->
            <Grid Grid.Row="0" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Твоя подписка" Style="{StaticResource ScreenTitle}"/>
                    <TextBlock Text="Продлевается вручную — списаний врасплох не будет" FontWeight="Medium" FontSize="{s:Fs 12}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GlassCircleButton}" VerticalAlignment="Top" Margin="10,0,0,0"
                        Command="{Binding RefreshCommand}">
                    <Grid>
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource TealDeepBrush}"
                              Visibility="{Binding Refreshing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <controls:Spinner Foreground="{DynamicResource TealBrush}"
                                          Visibility="{Binding Refreshing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Карточка подписки: primaryContainer r28, кольцо дней, тариф, АКТИВНА, «Оплатить в личном кабинете ↗». -->
            <controls:GlassPanel Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="28" Tint="{DynamicResource TealTintBrush}" Margin="0,12,0,0">
                <Grid>
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:DaysRing Days="{Binding DaysLeft}" TotalDays="{Binding DaysTotal}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                                <TextBlock FontWeight="Medium" FontSize="{s:Fs 13}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="Ваш тариф: "/><Run Text="{Binding PlanName, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </TextBlock>
                                <TextBlock FontWeight="Medium" FontSize="{s:Fs 11.5}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0">
                                    <Run Text="До "/><Run Text="{Binding ExpiryLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <controls:ActiveBadge Grid.Column="2" Text="АКТИВНА" VerticalAlignment="Center"
                                                  Visibility="{Binding IsSubscriptionActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <Button Style="{StaticResource AccentPillButton}" Margin="0,12,0,0" Command="{Binding OpenCabinetCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Оплатить в личном кабинете" FontSize="{s:Fs 14}" FontWeight="Bold" Foreground="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource IconNorthEast}" Style="{StaticResource Icon}" Width="13" Height="13" Fill="{DynamicResource SurfaceBrush}" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:GlassPanel>

        <controls:SegmentedControl Grid.Row="2" ItemsSource="{Binding Sections}" DisplayMemberPath="Label"
                                   SelectedIndex="{Binding SectionIndex, Mode=TwoWay}" ItemHeight="34" LabelFontSize="12" Margin="0,12,0,0"/>

        <Grid Grid.Row="3">
            <Grid Visibility="{Binding IsDevicesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding DevicesSectionLabel}" Style="{StaticResource SectionLabel}" Margin="8,14,8,0"
                           Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Text="Список устройств появится, когда подписка будет активна." FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,0"
                           Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <controls:GlassPanel Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,8,0,0" VerticalAlignment="Top"
                                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <TextBlock Text="Нет подключённых устройств" FontWeight="Medium" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="14" Visibility="{Binding Devices.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}"/>
                        <controls:PagedItems ItemsSource="{Binding Devices}">
                            <controls:PagedItems.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Rectangle Style="{StaticResource PagedSep}"/>
                                        <Grid Margin="14,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{s:Fs 13.5}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontWeight="Medium" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <controls:Spinner Grid.Column="1" Foreground="{DynamicResource TealBrush}"
                                                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Button Style="{StaticResource BareButton}" Padding="7" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Переименовать устройство"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconEdit}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource TealDeepBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource BareButton}" Padding="7"
                                                        Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="Удалить устройство"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </controls:PagedItems.ItemTemplate>
                        </controls:PagedItems>
                    </Grid>
                </controls:GlassPanel>
                <!-- Перенос входа на другое устройство по QR — без почты (порт 7060e31). -->
                <Button Grid.Row="2" Style="{StaticResource BareButton}" controls:Press.Scale="0.98" Margin="0,12,0,0" Command="{Binding ShowTransferQrCommand}"
                        AutomationProperties.Name="Перенести на другое устройство">
                    <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource TealTintBrush}">
                                <Path Data="{StaticResource IconQr}" Style="{StaticResource Icon}" Width="17" Height="17" Fill="{DynamicResource TealDeepBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="Перенести на другое устройство" FontWeight="Bold" FontSize="{s:Fs 13.5}"/>
                                <TextBlock Text="Вход без почты: покажи QR-код новому телефону" FontWeight="Medium" FontSize="{s:Fs 11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="{s:Fs 15.4}"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon}" Width="16" Height="16"
                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </controls:GlassPanel>
                </Button>
            </Grid>

            <Grid Visibility="{Binding IsFriendsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ПРИГЛАСИ ДРУЗЕЙ" Style="{StaticResource SectionLabel}" Margin="8,14,8,0"
                           Visibility="{Binding HasReferral, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="Программа приглашений пока недоступна." FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,0"
                           Visibility="{Binding HasReferral, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <controls:GlassPanel Grid.Row="1" Visibility="{Binding HasReferral, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource GlassCard}" Padding="14" Margin="0,8,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <controls:PillBorder Height="44" Padding="14,0,6,0" Background="{DynamicResource ChipBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Referral.Link}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <!-- QR ссылки: друг сканирует камерой прямо с экрана (порт 79b3e4b). -->
                                <Button Grid.Column="1" Style="{StaticResource BareButton}" Command="{Binding ShowReferralQrCommand}" VerticalAlignment="Center"
                                        Width="32" Height="32" Margin="0,0,6,0" ToolTip="QR-код ссылки" AutomationProperties.Name="QR-код ссылки">
                                    <Border CornerRadius="16" Background="{DynamicResource ThumbBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Path Data="{StaticResource IconQr}" Style="{StaticResource Icon}" Width="15" Height="15" Fill="{DynamicResource TealDeepBrush}"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource BareButton}" Command="{Binding CopyReferralLinkCommand}" VerticalAlignment="Center">
                                    <controls:PillBorder Height="32" Padding="12,0" Background="{DynamicResource AccentGradientBrush}">
                                        <TextBlock Text="Копировать" FontWeight="Bold" FontSize="{s:Fs 11.5}" Foreground="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"/>
                                    </controls:PillBorder>
                                </Button>
                            </Grid>
                        </controls:PillBorder>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Referral.TotalReferrals}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Приглашено" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Style="{StaticResource VHair}"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Referral.ActiveReferrals}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Активных" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Style="{StaticResource VHair}"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock FontWeight="Bold" FontSize="{s:Fs 20}" Foreground="{DynamicResource TealDeepBrush}" HorizontalAlignment="Center">
                                    <Run Text="+"/><Run Text="{Binding Referral.TotalBonusDays, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Бонус дней" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.Row="2" Style="{StaticResource Hair}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="3" Text="У вас пока нет приглашённых пользователей" FontWeight="Medium" FontSize="{s:Fs 12}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7" TextWrapping="Wrap"
                                   Visibility="{Binding Referral.HasEntries, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <controls:PagedItems Grid.Row="4" ItemsSource="{Binding Referral.Entries}">
                            <controls:PagedItems.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ChipBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{s:Fs 12.5}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BonusLabel}" FontWeight="Bold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TealDeepBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Visibility="{Binding HasBonusLabel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- Статус: активен — TealTint + сплошная обводка Teal + точка; иначе — пунктир. -->
                                        <Grid Grid.Column="3" Height="22" VerticalAlignment="Center">
                                            <Rectangle x:Name="StatusFrame" RadiusX="11" RadiusY="11" StrokeThickness="1"
                                                       Stroke="{DynamicResource TextSecondaryBrush}" StrokeDashArray="3 3" Fill="Transparent"/>
                                            <StackPanel Orientation="Horizontal" Margin="7,0,9,0" VerticalAlignment="Center">
                                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="Transparent" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StatusText" Text="{Binding StatusBadge}" FontWeight="ExtraBold" FontSize="{s:Fs 10}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="StatusFrame" Property="Stroke" Value="{DynamicResource TealBrush}"/>
                                            <Setter TargetName="StatusFrame" Property="StrokeDashArray" Value="{x:Null}"/>
                                            <Setter TargetName="StatusFrame" Property="Fill" Value="{DynamicResource TealTintBrush}"/>
                                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TealBrush}"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </controls:PagedItems.ItemTemplate>
                        </controls:PagedItems>
                    </Grid>
                </controls:GlassPanel>
            </Grid>

            <Grid Visibility="{Binding IsNewsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Новостей пока нет." FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,0"
                           Visibility="{Binding HasNews, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <controls:PagedItems ItemsSource="{Binding AllNews}">
                    <controls:PagedItems.ItemTemplate>
                        <DataTemplate>
                            <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24" Padding="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <RichTextBox utils:RichTextBoxBehavior.AttachedDocument="{Binding Document}" IsReadOnly="True" IsDocumentEnabled="True" Focusable="False"
                                                 BorderThickness="0" Background="Transparent" Padding="0" Margin="0,7,0,0"
                                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                                    <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,7,0,0"
                                                  Visibility="{Binding Buttons.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChipButton}" Height="32" Margin="0,0,6,6" Content="{Binding Text}"
                                                        Command="{Binding DataContext.OpenBroadcastButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Url}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:GlassPanel>
                        </DataTemplate>
                    </controls:PagedItems.ItemTemplate>
                </controls:PagedItems>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
