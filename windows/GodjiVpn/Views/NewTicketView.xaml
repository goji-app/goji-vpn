<UserControl x:Class="GodjiVpn.Views.NewTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <!-- Новое обращение v5 «Стекло» — NewTicketScreen.kt: круглая "назад" + заголовок, форма
         в стеклянной карточке (очередь капсулами, тема, сообщение), градиентная "Отправить". -->
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GlassCircleButton}" Command="{Binding BackCommand}" AutomationProperties.Name="Назад">
                <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource Icon}" Width="20" Height="20" Fill="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <TextBlock Grid.Column="1" Text="Новое обращение" FontWeight="SemiBold" FontSize="{s:Fs 22}" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Без прокрутки: форма на всё оставшееся место, поле сообщения растягивается. -->
        <Grid Grid.Row="1" Margin="16,0,16,16">

                <controls:Spinner Foreground="{DynamicResource TealBrush}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,30,0,0"
                                  Visibility="{Binding Loading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Visibility="{Binding Loading, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <!-- Лимит открытых обращений — форма скрыта, вместо неё переход в активное
                         обращение (NewTicketViewModel.LoadAsync проверяет это до показа формы). -->
                    <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24" Tint="{DynamicResource TerracottaTintBrush}" VerticalAlignment="Top"
                                         Visibility="{Binding CanCreate, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Margin="18">
                            <TextBlock Text="Уже есть активное обращение" FontWeight="Bold" FontSize="{s:Fs 15}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Продолжите переписку в существующем обращении." FontWeight="Medium" FontSize="{s:Fs 12.5}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                            <Button Style="{StaticResource InkPillButton}" Height="46" FontSize="{s:Fs 14}" Margin="0,14,0,0"
                                    Content="Перейти к обращению" Command="{Binding OpenActiveTicketCommand}"
                                    Visibility="{Binding HasActiveTicketId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </controls:GlassPanel>

                    <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24"
                                         Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Visibility="{Binding ShowQueuePicker, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,14">
                                <TextBlock Text="КУДА ОБРАТИТЬСЯ" FontWeight="SemiBold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Queues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BareButton}" Margin="0,0,6,6" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.SelectQueueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <controls:PillBorder x:Name="Pill" Height="34" Padding="14,0" BorderThickness="1"
                                                                     Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                                    <TextBlock x:Name="Label" Text="{Binding Name}" FontWeight="Bold" FontSize="{s:Fs 12}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </controls:PillBorder>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource InkBtnBrush}"/>
                                                    <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBtnTextBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="ТЕМА (НЕОБЯЗАТЕЛЬНО)" FontWeight="SemiBold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                            <TextBox Grid.Row="2" Style="{StaticResource GlassTextBox}" FontSize="{s:Fs 13}" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="СООБЩЕНИЕ" FontWeight="SemiBold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,14,0,8"/>
                            <Grid Grid.Row="4">
                                <TextBox Style="{StaticResource GlassTextBox}" FontSize="{s:Fs 13}" TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="80" VerticalAlignment="Stretch" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Что случилось? Чем подробнее — тем быстрее поможем" FontWeight="Medium" FontSize="{s:Fs 13}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="17,12,14,0" TextWrapping="Wrap"
                                           VerticalAlignment="Top" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Message}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" FontSize="{s:Fs 11.5}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="4,10,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                            <Grid Grid.Row="6" Margin="0,14,0,0">
                                <Button Style="{StaticResource AccentPillButton}" Height="48" Content="Отправить" Command="{Binding SubmitCommand}"
                                        Visibility="{Binding Submitting, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <controls:Spinner Foreground="{DynamicResource TealBrush}" Width="22" Height="22" HorizontalAlignment="Center"
                                                  Visibility="{Binding Submitting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </controls:GlassPanel>
                </Grid>
        </Grid>
    </Grid>
</UserControl>
