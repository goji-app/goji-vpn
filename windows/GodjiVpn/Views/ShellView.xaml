<UserControl x:Class="GodjiVpn.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <UserControl.Resources>
        <!-- Вкладка нижней панели M3 Expressive (порт Android GlassTabBar.kt, 163f5ab): иконка
             из эталона (обводка 2) на таблетке-индикаторе secondaryContainer 56×32, которая у
             выбранной вкладки раскрывается пружиной от 24 до 56; подпись 12, у выбранной — Bold и
             TextPrimary, у остальных — SemiBold и TextSecondary. -->
        <Style x:Key="GlassTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="56" Height="32" HorizontalAlignment="Center">
                                    <Border x:Name="Indicator" Width="24" CornerRadius="16" Background="{DynamicResource LensBrush}"
                                            HorizontalAlignment="Center" Opacity="0"/>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource ManropeFamily}" FontWeight="SemiBold" FontSize="{s:Fs 12}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource OnSecondaryContainerBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- spring(dampingRatio 0.6, stiffness 500) — ElasticEase с одним перелётом. -->
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Width"
                                                             From="24" To="56" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Width"
                                                             To="24" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <!-- Нижняя панель 64 — контент над ней. -->
        <Grid Margin="0,0,0,64">
            <ContentControl Content="{Binding Connect}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}"/>
            <ContentControl Content="{Binding Servers}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}"/>
            <ContentControl Content="{Binding Plans}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}"/>
            <ContentControl Content="{Binding Settings}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}"/>
        </Grid>

        <!-- Короткая нижняя панель навигации M3 Expressive: во всю ширину, surfaceContainer,
             высота 64. -->
        <Border Height="64" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceContainerBrush}">
            <UniformGrid Rows="1" Columns="4">
                <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconHome}" Content="Главная"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconServers}" Content="Серверы"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconPlans}" Content="Подписка"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconSettings}" Content="Настройки"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"/>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
