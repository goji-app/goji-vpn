<Window x:Class="GodjiVpn.Views.WebLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход через сайт" Height="720" Width="460"
        MinHeight="480" MinWidth="360"
        Background="{DynamicResource BgSolidBrush}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- Нативный обмен кода на токен (api/auth/native/exchange) сломан на бэкенде 7.1.0 —
         отвечает 400 на любой запрос, независимо от провайдера (см. комментарий в
         LoginViewModel.OpenWebLoginAsync). Обходной путь, портированный с Android
         (WebLoginActivity.kt): показываем пользователю тот же сайт целиком во встроенном
         WebView2 — пусть логинится любым способом (Google/Яндекс/Telegram/email), которым
         пользуются обычные посетители сайта, — и забираем сессионный токен прямо из куки
         rw_session_token, которую сайт сам выставляет по завершении входа. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" FontSize="{s:Fs 22}" Padding="0,0,10,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource TextPrimaryBrush}" Click="OnCloseClick"/>
            <TextBlock Grid.Column="1" Text="Вход через сайт" FontFamily="{StaticResource ManropeSemiBoldFamily}"
                       FontSize="{s:Fs 15}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>

        <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" IsIndeterminate="True"
                     Foreground="{DynamicResource TealBrush}" Background="Transparent" BorderThickness="0"
                     Visibility="Collapsed"/>

        <wv2:WebView2 x:Name="Web" Grid.Row="2"/>
    </Grid>
</Window>
